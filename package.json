{
  "name": "meeple-shelf",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "migrate": "node -e \"import('./src/migrate.js').then(m=>m.migrate()).then(()=>process.exit())\"",
    "api": "node src/server.js",
    "worker": "node worker/index.js",
    "backfill": "BACKFILL=1 node worker/sync.js",
    "db:up": "docker compose up -d",
    "test:e2e": "node test/e2e.js",
    "check:bgg": "node scripts/check-bgg.js",
    "dev:mock": "SOURCE=mock MOCK_MAX_ID=10 BACKFILL=1 node worker/sync.js",
    "test:frontier": "node test/frontier.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^4.19.2",
    "fast-xml-parser": "^4.4.0",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.14",
    "pg": "^8.12.0"
  },
  "engines": {
    "node": ">=20"
  }
}